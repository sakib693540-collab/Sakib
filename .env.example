# GEMINI_API_KEY: Required if server-side AI endpoints are enabled.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# VITE_BACKEND_WS_URL: Optional WebSocket endpoint for online multiplayer when
# running as a standalone packaged Capacitor Android APK outside the web host.
# Example: wss://your-sholo-guti-server.run.app/ws
VITE_BACKEND_WS_URL=""
